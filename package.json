{
  "name": "agents-md-sync",
  "version": "1.0.0",
  "description": "Compose AGENTS.md from a central markdown template directory and per-repo .agents/ addenda.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trick77/agents-md-sync.git"
  },
  "bugs": {
    "url": "https://github.com/trick77/agents-md-sync/issues"
  },
  "homepage": "https://github.com/trick77/agents-md-sync#readme",
  "keywords": [
    "agents.md",
    "ai",
    "cli",
    "markdown",
    "template",
    "sync",
    "ci"
  ],
  "type": "module",
  "bin": {
    "agents-md-sync": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run check:samples && npm run lint && vitest run",
    "dev": "node --import tsx src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "render:samples": "node --import tsx scripts/render-samples.ts",
    "check:samples": "node --import tsx scripts/check-samples.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^5.0.1"
  }
}
